<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../style/main.css" />
    <title>My App</title>
    <link rel="icon" type="image/png" href="../img/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="../img/favicon.svg" />
    <link rel="shortcut icon" href="../img/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="../img/apple-touch-icon.png" />
    <link rel="manifest" href="/style/main.css" />
    <import src="./components/route.heml" as="route" />
    <import src="./components/router.heml" as="router" />
    <import src="./components/footer.heml" as="footercomp" />
    <import src="./pages/aboutme.heml" as="aboutme" />
    <import src="./pages/dashboard.heml" as="dashboard" />
    <import src="./pages/why-it.heml" as="why-it" />
    <import src="./pages/home.heml" as="home" />
</head>

<body>
    <router>
        <router:home>
            <home />
        </router:home>
        <router:404>
            <h1 style="text-align: center; margin-top: 5rem; height: calc(100vh - 5rem);">
                Page Can Not Be Found
                <br />
                <a style="font-size: 1rem;" onclick="window.navigateToPage('home')">[&larr; Go back]</a>
            </h1>
        </router:404>
        <route name="aboutme">
            <aboutme />
        </route>
        <route name="why-it">
            <why-it />
        </route>
        <route name="dashboard">
            <dashboard />
        </route>
    </router>

    <footercomp />
</body>

</html>