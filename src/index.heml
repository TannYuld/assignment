<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style/main.css" />
    <title>My App</title>

    <link rel="icon" type="image/png" href="/img/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/img/favicon.svg" />
    <link rel="shortcut icon" href="/img/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png" />

    <import src="./components/route.heml" as="route" />
    <import src="./components/router.heml" as="router" />
    <import src="./components/footer.heml" as="footercomp" />

    <import src="./pages/aboutme.heml" as="page:aboutme" />
    <import src="./pages/blog.heml" as="page:blog" />
    <import src="./pages/post.heml" as="page:post" />
    <import src="./pages/dashboard.heml" as="page:dashboard" />
    <import src="./pages/why-it.heml" as="page:why-it" />
    <import src="./pages/home.heml" as="page:home" />
    <import src="./pages/404.heml" as="page:404" />
</head>

<body>
    <var name="blogPosts" value="{[]}"/>

    <router>
        <router:home>
            <page:home />
        </router:home>
        <router:404>
            <page:404/>
        </router:404>
        <route name="aboutme">
            <page:aboutme />
        </route>
        <route name="why-it">
            <page:why-it />
        </route>
        <route name="dashboard">
            <page:dashboard />
        </route>
        <route name="blog">
            <page:blog allBlogs="{blogPosts}" />
        </route>
        <route name="post">
            <page:post allPosts="{blogPosts}"/>
        </route>
    </router>

    <footercomp />

    <script async type="module">
        const { retrieveData, fetchDataIfIntegrityNotMatch } = await import('./script/main.js');

        blogPosts.value = retrieveData();
        blogPosts.value = await fetchDataIfIntegrityNotMatch();
    </script>
</body>

</html>