<!DOCTYPE component>
<import src="../components/navigation.heml" as="navigation" />
<properties>
</properties>
<component>
    <div id="outermost-container">
        <h1>Home Page</h1>
        <div class="waltuh">
            <img src="/img/waltuh.webp" />
            <img src="/img/waltuh-alt.jpg" />
        </div>
        <h3>Onur Altintas</h3>
        <h5>Currently a computer enthousiast, aims to be an computer wizard.</h5>
        <div style="width: 35rem; margin-bottom: 1.5rem;">
            <div class="divider"></div>
        </div>
        <navigation hasEasterEgg/>
    </div>

    <style scoped>
        img {
            width: 600px;
            height: 400px;
        }

        .waltuh {
            display: grid;
        }

        .waltuh>img {
            grid-row: 1;
            grid-column: 1;
        }

        .waltuh>img:nth-child(1) {
            z-index: 1;
        }

        .waltuh:hover>img:nth-child(1) {
            z-index: -3;
        }
    </style>
</component>