<!DOCTYPE component>
<import src="../components/back-button.heml" as="back-button" />
<import src="../components/blog-preview.heml" as="blog-preview" />
<properties>
    <attribute name="allBlogs" />
</properties>
<component>
    <div id="outermost-container">
        <back-button />

        <h1>Blog Posts</h1>
        Here are my blogposts of my personal development and growth.
        <div style="width: 45rem;" class="divider"></div>
        <div class="blogs">
            <for each="{allBlogs}" as="post" index="i" key="{post.id}">
                <blog-preview post="{post}" postIdx="{i}"/>
            </for>
        </div>
    </div>

    <style scoped>
        .blogs {
            display: flex;
            flex-direction: column;
            gap: 0rem;

            max-width: 45rem;
            text-align: left;
        }
    </style>
</component>