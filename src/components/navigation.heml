<!DOCTYPE component>
<properties>
    <attribute name="hasEasterEgg" optional />
</properties>
<component>
    <script>
        window.addEventListener('route-change', (page) => {
            currentPage.value = page.detail;
        });
    </script>

    <var name="switchPage" value="{
        (pageVal) => {
            window.navigateToPage(pageVal);
            window.scrollTo(0, 0);
        }
    }" />
    <var name="currentPage" value="home" />

    <ol class="pages-selection">
        <li>
            <a onclick="{(switchPage.value)('aboutme')}">
                <if condition="{currentPage.value === 'aboutme'}">
                    <span class="bold-text">
                        [[./aboutme]]
                    </span>
                </if>
                <else>
                    [./aboutme]
                </else>
            </a>
        </li>
        <li>
            <a onclick="{(switchPage.value)('why-it')}">
                <if condition="{currentPage.value === 'why-it'}">
                    <span class="bold-text">
                        [[./why-it]]
                    </span>
                </if>
                <else>
                    [./why-it]
                </else>
            </a>
        </li>
        <li>
            <a onclick="{(switchPage.value)('dashboard')}">
                <if condition="{currentPage.value === 'dashboard'}">
                    <span class="bold-text">
                        [[./dashboard]]
                    </span>
                </if>
                <else>
                    [./dashboard]
                </else>
            </a>
        </li>
        <li style="width: 4.8rem; display: inline-block; vertical-align: top;" class="easter-egg-container">
            <a onclick="(switchPage.value)('blog')">
                <if condition="{currentPage.value === 'blog'}">
                    <span class="bold-text">
                        [[./blog]]
                    </span>
                </if>
                <else>
                    [./blog]
                </else>
            </a>
            <span style="font-size: .5rem;" class="easter-egg">
                <br>
                <a href="https://onur.altintaslar.tr">[./my_real_blog]</a>
            </span>
        </li>
    </ol>

    <if condition="{hasEasterEgg && hasEasterEgg.value === true}">
        <style scoped>
            .easter-egg-container:hover>.easter-egg {
                animation: fadeInSlide 0.4s ease-out forwards;
                animation-delay: 5s;
                transition-delay: 4.9s;
                display: block;
            }
        </style>
    </if>
    <style scoped>
        a:hover {
            cursor: pointer;
        }

        .pages-selection {
            display: flex;
            gap: 3rem;
            font-size: 1rem;
            flex-wrap: nowrap;
        }

        .pages-selection>li>a {
            text-wrap: nowrap;
        }

        .easter-egg-container>.easter-egg {
            opacity: 0;
            display: none;
        }
    </style>
    <style>
        @keyframes fadeInSlide {
            from {
                opacity: 0;
                transform: translateY(-5px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        ;
    </style>
</component>